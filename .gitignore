# Static/media generated at runtime (user uploads, generated QR codes)
# NOTE: serveware/static/media/ also holds hand-placed marketing assets
# referenced directly by templates (e.g. home.html) - only ignore the
# subfolders that are populated by uploads/generated files at runtime.
serveware/staticfiles/
serveware/static/media/menu_images/
serveware/static/media/table_qr/
serveware/static/media/qr_codes/

