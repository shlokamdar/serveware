# Copy this file to `.env` in the same directory (next to manage.py) and
# fill in real values. Never commit the resulting `.env` file.

# A long, random, unique string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" for local development, "False" in any deployed environment.
DJANGO_DEBUG=True

# Comma-separated list of hostnames this app is allowed to serve.
# Example: DJANGO_ALLOWED_HOSTS=serveware.example.com,www.serveware.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Python logging level for the root/django loggers: DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO

# SMTP settings used to send OTP emails (signup/password reset).
# Leave EMAIL_HOST_PASSWORD blank to fall back to Django's console email
# backend for local development - no real credentials required.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
